	{
		return false;
	}
	if(!DecodeChar(packet.cBRLectureMark))
	{
		return false;
	}
	if(!DecodeInt(nSize))
	{
		return false;
	}
	packet.abnormalVisualEffect.Length = nSize;
	i = 0;
	while((i < packet.abnormalVisualEffect.Length))
	{
		if(!DecodeShort(packet.abnormalVisualEffect[i]))
		{
			return false;
