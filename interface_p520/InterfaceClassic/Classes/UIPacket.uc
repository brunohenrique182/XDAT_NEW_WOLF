	{
		return false;
	}
	i = GetCurDecodePos();
	if(!DecodeShort(nSize))
	{
		return false;
	}
	if(!Decode_OptionalNoKey(packet.optionalNoKey_ST_BACK))
	{
		return false;
	}
	if(((GetCurDecodePos() - i) > nSize))
	{
		return false;
	}
	if(!DecodeChar(packet.nMinNewSetItemEchantedEffect))
	{
