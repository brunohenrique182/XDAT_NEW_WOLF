	}
	if(!EncodeInt(stream, packet.nSelectIndexSub))
	{
		return false;
	}
	if(!EncodeInt(stream, packet.nSelectSlot))
	{
		return false;
	}
	i = stream.Length;
	if(!EncodeShort(stream, 0))
	{
		return false;
	}
	if(!Encode_VirtualItemInfo(stream, packet.updateVisItemInfo))
	{
		return false;
	}
	if(!SetShort(stream, i, (stream.Length - i)))
	{
		return false;
	}
	return true;
}

