static function bool Encode_C_EX_COSTUME_EXTRACT(out array<byte> stream, _C_EX_COSTUME_EXTRACT packet)
{
	local int i;

	i = stream.Length;
	if(!EncodeShort(stream, 0))
	{
		return false;
	}
	if(!Encode_tCostumeAmount(stream, packet.tExtract))
	{
