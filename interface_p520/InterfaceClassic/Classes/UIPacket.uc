static function bool Decode_S_EX_CROSS_EVENT_DATA(out _S_EX_CROSS_EVENT_DATA packet)
{
	local int i, nSize;

	if(!DecodeInt(nSize))
	{
		return false;
	}
	packet.normalRewards.Length = nSize;
	i = 0;
	while((i < packet.normalRewards.Length))
	{
		if(!Decode_ItemInfo(packet.normalRewards[i]))
		{
			return false;
		}
		i++;
	}
	if(!DecodeInt(nSize))
	{
		return false;
	}
	packet.rareRewards.Length = nSize;
	i = 0;
	while((i < packet.rareRewards.Length))
	{
		if(!Decode_ItemInfo(packet.rareRewards[i]))
		{
			return false;
		}
		i++;
	}
	i = GetCurDecodePos();
	if(!DecodeShort(nSize))
	{
		return false;
	}
	if(!Decode_ItemInfo(packet.resetItemData))
	{
		return false;
	}
	if(((GetCurDecodePos() - i) > nSize))
	{
		return false;
	}
	if(!DecodeInt(packet.nSeason))
	{
		return false;
	}
	return true;
}

