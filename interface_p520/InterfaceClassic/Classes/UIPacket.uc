static function bool Decode_S_EX_CROSS_EVENT_INFO(out _S_EX_CROSS_EVENT_INFO packet)
{
	local int i, nSize;

	if(!DecodeBool(packet.bOnEvent))
	{
		return false;
	}
	if(!DecodeInt(nSize))
	{
		return false;
	}
	packet.blocks.Length = nSize;
	i = 0;
	while((i < packet.blocks.Length))
	{
		if(!Decode_CrossBlock(packet.blocks[i]))
		{
			return false;
		}
		i++;
	}
	if(!DecodeInt(packet.nCoupon))
	{
		return false;
	}
	if(!DecodeInt(packet.nRareRewardCnt))
	{
		return false;
	}
